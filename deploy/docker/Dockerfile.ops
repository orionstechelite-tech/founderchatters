# syntax=docker/dockerfile:1
# Short-lived staging operations image. Not started by a normal compose up.
# Needs Prisma CLI, generated client, and tsx for RBAC catalog sync only.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/ui/package.json packages/ui/
COPY packages/config/package.json packages/config/
COPY packages/test-utils/package.json packages/test-utils/
# Ignore lifecycle scripts so Playwright/Next postinstall cannot pull browsers
# or frontend toolchains into this operator image.
RUN npm ci --ignore-scripts

FROM deps AS tools
WORKDIR /app
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/founderchatters_build
COPY prisma ./prisma
COPY prisma.config.ts ./
COPY packages/config ./packages/config
COPY packages/contracts ./packages/contracts
COPY apps/api/src/admin/admin-rbac.ts apps/api/src/admin/admin-rbac.ts
COPY scripts/sync-admin-rbac-catalog.ts scripts/sync-admin-rbac-catalog.ts
COPY deploy/docker/ops-entrypoint.sh deploy/docker/ops-entrypoint.sh
RUN npx prisma generate \
  && npm run build --workspace @founderchatters/contracts \
  && chmod +x deploy/docker/ops-entrypoint.sh \
  && rm -rf \
    apps/web \
    packages/ui \
    packages/test-utils \
    node_modules/next \
    node_modules/@next \
    node_modules/react \
    node_modules/react-dom \
    node_modules/styled-jsx \
    node_modules/playwright \
    node_modules/playwright-core \
    node_modules/@playwright \
    node_modules/vitest \
    node_modules/@vitest \
    node_modules/eslint \
    node_modules/@eslint \
    node_modules/prettier \
    node_modules/@img \
    node_modules/@visx \
    node_modules/elkjs \
    node_modules/caniuse-lite \
    node_modules/fast-check \
    node_modules/typescript \
    node_modules/@types

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 10001 fc \
  && useradd --system --uid 10001 --gid fc --home-dir /app --shell /usr/sbin/nologin fc
COPY --from=tools --chown=fc:fc /app/package.json /app/package-lock.json ./
COPY --from=tools --chown=fc:fc /app/node_modules ./node_modules
COPY --from=tools --chown=fc:fc /app/prisma ./prisma
COPY --from=tools --chown=fc:fc /app/prisma.config.ts ./
COPY --from=tools --chown=fc:fc /app/generated ./generated
COPY --from=tools --chown=fc:fc /app/packages/config ./packages/config
COPY --from=tools --chown=fc:fc /app/packages/contracts ./packages/contracts
COPY --from=tools --chown=fc:fc /app/apps/api/package.json ./apps/api/
COPY --from=tools --chown=fc:fc /app/apps/api/src/admin/admin-rbac.ts ./apps/api/src/admin/admin-rbac.ts
COPY --from=tools --chown=fc:fc /app/scripts/sync-admin-rbac-catalog.ts ./scripts/sync-admin-rbac-catalog.ts
COPY --from=tools --chown=fc:fc /app/deploy/docker/ops-entrypoint.sh ./deploy/docker/ops-entrypoint.sh
USER fc
ENTRYPOINT ["/app/deploy/docker/ops-entrypoint.sh"]
CMD ["prisma", "migrate", "status"]
