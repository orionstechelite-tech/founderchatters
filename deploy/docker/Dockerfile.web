# syntax=docker/dockerfile:1
# Debian slim keeps Next.js standalone and native optional bindings on a glibc base.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/ui/package.json packages/ui/
COPY packages/config/package.json packages/config/
COPY packages/test-utils/package.json packages/test-utils/
RUN npm ci
# The Windows-generated lockfile does not materialize Linux optional Tailwind
# bindings. Install the glibc package for this image without rewriting lockfiles.
RUN npm pack @tailwindcss/oxide-linux-x64-gnu@4.3.3 \
  && mkdir -p node_modules/@tailwindcss/oxide-linux-x64-gnu \
  && tar -xzf tailwindcss-oxide-linux-x64-gnu-4.3.3.tgz \
    -C node_modules/@tailwindcss/oxide-linux-x64-gnu \
    --strip-components=1 \
  && rm tailwindcss-oxide-linux-x64-gnu-4.3.3.tgz

FROM deps AS build
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_TELEMETRY_DISABLED=1
COPY packages/config ./packages/config
COPY packages/contracts ./packages/contracts
COPY packages/ui ./packages/ui
COPY apps/web ./apps/web
COPY tooling/next-cli.mjs tooling/next-cli.mjs
RUN test -n "$NEXT_PUBLIC_API_URL" \
  && npm run build --workspace @founderchatters/contracts \
  && npm run build --workspace @founderchatters/web

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 10001 fc \
  && useradd --system --uid 10001 --gid fc --home-dir /app --shell /usr/sbin/nologin fc
COPY --from=build --chown=fc:fc /app/apps/web/.next/standalone ./
COPY --from=build --chown=fc:fc /app/apps/web/.next/static ./apps/web/.next/static
RUN mkdir -p /app/apps/web/public && chown fc:fc /app/apps/web/public
USER fc
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then((response)=>process.exit(response.status===200?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "apps/web/server.js"]
