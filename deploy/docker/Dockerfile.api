# syntax=docker/dockerfile:1
# Debian slim avoids Alpine native-module risk for argon2 and Prisma.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/ui/package.json packages/ui/
COPY packages/config/package.json packages/config/
COPY packages/test-utils/package.json packages/test-utils/
RUN npm ci

FROM deps AS build
# Prisma 7 config requires DATABASE_URL to load prisma.config.ts during generate.
# This value is build-only and is not copied into the runtime image.
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/founderchatters_build
COPY prisma ./prisma
COPY prisma.config.ts ./
COPY packages/config ./packages/config
COPY packages/contracts ./packages/contracts
COPY apps/api ./apps/api
COPY scripts/copy-api-prisma-client.mjs scripts/copy-api-prisma-client.mjs
RUN npx prisma generate \
  && npm run build --workspace @founderchatters/contracts \
  && npm run build --workspace @founderchatters/api

FROM deps AS production-deps
WORKDIR /app
# Keep workspace production deps, then drop web/test/toolchain trees the API
# runtime never imports. Prisma CLI stays in the ops image, not here.
RUN npm prune --omit=dev \
  && rm -rf \
    apps/web \
    packages/ui \
    packages/test-utils \
    node_modules/next \
    node_modules/@next \
    node_modules/react \
    node_modules/react-dom \
    node_modules/styled-jsx \
    node_modules/playwright \
    node_modules/playwright-core \
    node_modules/@playwright \
    node_modules/typescript \
    node_modules/@types \
    node_modules/prisma \
    node_modules/vitest \
    node_modules/@vitest \
    node_modules/eslint \
    node_modules/@eslint \
    node_modules/prettier \
    node_modules/@img \
    node_modules/@visx \
    node_modules/elkjs \
    node_modules/caniuse-lite \
    node_modules/fast-check

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 10001 fc \
  && useradd --system --uid 10001 --gid fc --home-dir /app --shell /usr/sbin/nologin fc
COPY --from=production-deps --chown=fc:fc /app/package.json /app/package-lock.json ./
COPY --from=production-deps --chown=fc:fc /app/node_modules ./node_modules
COPY --from=production-deps --chown=fc:fc /app/apps/api/package.json ./apps/api/
COPY --from=build --chown=fc:fc /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=fc:fc /app/packages/contracts ./packages/contracts
USER fc
WORKDIR /app/apps/api
ENV NODE_ENV=production
EXPOSE 4000
# Image liveness is process-only. Compose dependency gating uses /health/ready.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/v1/health/live').then((response)=>process.exit(response.status===200?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "dist/apps/api/src/main.js"]
