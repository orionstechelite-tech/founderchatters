# Fictional values for `docker compose config` only.
# Do not use this file as a live staging environment.
# Preflight must still fail closed because no email provider is approved.

NODE_ENV=staging
LOG_LEVEL=log
STAGING_WEB_HOST=app.staging.example.invalid
STAGING_API_HOST=api.staging.example.invalid
STAGING_ACME_EMAIL=operator@staging.example.invalid
WEB_URL=https://app.staging.example.invalid
API_URL=https://api.staging.example.invalid
NEXT_PUBLIC_API_URL=https://api.staging.example.invalid
ALLOWED_ORIGINS=https://app.staging.example.invalid
TRUST_PROXY_ADDRESSES=172.30.0.10
POSTGRES_USER=fc_staging_validation
POSTGRES_PASSWORD=fc-staging-validation-password-not-for-use
POSTGRES_DB=founderchatters_staging_validation
DATABASE_URL=postgresql://fc_staging_validation:fc-staging-validation-password-not-for-use@postgres:5432/founderchatters_staging_validation
REDIS_URL=redis://redis:6379
SESSION_COOKIE_NAME=fc_session
SESSION_SECRET=fc-staging-validation-session-secret-not-for-use
AUTH_TOKEN_SECRET=fc-staging-validation-auth-token-secret-not-for-use
PASSWORD_PEPPER=fc-staging-validation-password-pepper-not-for-use
EMAIL_PROVIDER=unconfigured
EMAIL_FROM=no-reply@staging.example.invalid
EMAIL_API_KEY=
STAGING_BACKUP_DIR=/tmp/founderchatters-staging-validation-backups
STAGING_WEB_IMAGE=founderchatters-web:local
STAGING_API_IMAGE=founderchatters-api:local
STAGING_OPS_IMAGE=founderchatters-ops:local
SENTRY_DSN=
