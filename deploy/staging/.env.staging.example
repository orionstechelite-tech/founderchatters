# Copy to deploy/staging/.env.staging on the operator workstation.
# Never commit .env.staging. Never reuse development or production values.
# These placeholders are intentionally invalid and must fail preflight.

NODE_ENV=staging
LOG_LEVEL=log

# Public HTTPS origins. Replace with the approved staging hosts before deploy.
STAGING_WEB_HOST=replace-me-web-host
STAGING_API_HOST=replace-me-api-host
STAGING_ACME_EMAIL=replace-me-acme-email
WEB_URL=https://replace-me-web-host
API_URL=https://replace-me-api-host
NEXT_PUBLIC_API_URL=https://replace-me-api-host
ALLOWED_ORIGINS=https://replace-me-web-host

# Trust only the staging reverse-proxy hop from deploy/staging/docker-compose.yml.
TRUST_PROXY_ADDRESSES=172.30.0.10

# Internal service URLs. PostgreSQL and Redis are not published.
POSTGRES_USER=replace-me-postgres-user
POSTGRES_PASSWORD=replace-me-postgres-password
POSTGRES_DB=replace-me-postgres-db
DATABASE_URL=postgresql://replace-me-postgres-user:replace-me-postgres-password@postgres:5432/replace-me-postgres-db
REDIS_URL=redis://redis:6379

SESSION_COOKIE_NAME=fc_session
SESSION_SECRET=replace-me
AUTH_TOKEN_SECRET=replace-me
PASSWORD_PEPPER=replace-me
# CSRF_SECRET is present in local .env.example only. The API does not read it.

# HARD BLOCKER: memory is rejected in staging. An approved production-capable
# transactional email provider is still an open decision. Do not set this to
# memory, console, resend, ses, sendgrid, or postmark without explicit approval.
EMAIL_PROVIDER=unconfigured
EMAIL_FROM=replace-me-email-from
EMAIL_API_KEY=replace-me

STAGING_BACKUP_DIR=/var/backups/founderchatters-staging
# Live preflight requires a digest or 40-hex Git SHA tag, not :local/:latest/:staging.
STAGING_WEB_IMAGE=founderchatters-web:replace-me-revision
STAGING_API_IMAGE=founderchatters-api:replace-me-revision
STAGING_OPS_IMAGE=founderchatters-ops:replace-me-revision
SENTRY_DSN=
