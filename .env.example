NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated proxy IPs/CIDRs. Use "none" for an explicitly direct deployment.
# Required in staging/production; development defaults to no trusted proxy.
TRUST_PROXY_ADDRESSES=none

# Local Docker Compose services only. Do not reuse these credentials outside development.
POSTGRES_USER=founderchatters
POSTGRES_PASSWORD=founderchatters
POSTGRES_DB=founderchatters
POSTGRES_PORT=5432
DATABASE_URL=postgresql://founderchatters:founderchatters@localhost:5432/founderchatters

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

SESSION_COOKIE_NAME=fc_session
SESSION_SECRET=replace-me
AUTH_TOKEN_SECRET=replace-me
CSRF_SECRET=replace-me
PASSWORD_PEPPER=replace-me

EMAIL_PROVIDER=memory
EMAIL_FROM=no-reply@founderchatters.local
EMAIL_API_KEY=

STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

LOG_LEVEL=debug
SENTRY_DSN=
